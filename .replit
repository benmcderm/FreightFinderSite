modules = ["nodejs-24"]

# Static multi-page marketing site (plain HTML, Vite MPA build). The build
# substitutes {{TOKEN}}s from site.config.ts and emits robots.txt +
# sitemap.xml; serve.mjs then serves dist/ with directory-index resolution
# (/load-board-app/ -> load-board-app/index.html) and real 404s.
run = ["sh", "-c", "npm install && PORT=5000 BASE_PATH=/ npm run build && node serve.mjs"]

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && PORT=5000 BASE_PATH=/ npm run build"]
run = ["node", "serve.mjs"]

[[ports]]
localPort = 5000
externalPort = 80
